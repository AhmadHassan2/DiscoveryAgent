# ---------------------------------------------------------------- Database
# Local PostgreSQL with the pgvector extension (Docker Compose uses the same URL with host "db").
DATABASE_URL=postgresql+psycopg://localhost:5432/idea_discovery

# ---------------------------------------------------------------- LLM (optional)
# auto | anthropic | openai_compatible | none
#   auto -> Claude if Anthropic credentials are present, else the gateway if configured, else deterministic mode.
LLM_PROVIDER=auto

# Claude via the official Anthropic SDK. Credentials are read by the SDK itself:
# ANTHROPIC_API_KEY (or an `ant auth login` profile). Never commit a real key.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# Any OpenAI-compatible endpoint, e.g. an internal enterprise LLM gateway.
# LLM_BASE_URL=https://llm-gateway.internal.example/v1
# LLM_API_KEY=
# LLM_MODEL=

# Embeddings (optional). Without these, the deterministic local concept embedder is used.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------- Connectors
# Simulated network latency for mock connectors (ms). 0 disables it.
MOCK_CONNECTOR_LATENCY_MS=350
# Force-fail sources to demonstrate degraded behaviour, e.g. FAIL_SOURCES=sharepoint
FAIL_SOURCES=
CONNECTOR_TIMEOUT_SECONDS=5

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SEED=true
